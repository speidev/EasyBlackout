<Window x:Class="EasyBlackout.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasyBlackout.ViewModels"
        xmlns:v="clr-namespace:EasyBlackout.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="EasyBlackout"
        Icon="/Assets/EasyBlackout.ico"
        Width="900" Height="720" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}"
        UseLayoutRounding="True">

    <Window.Resources>
        <v:BoolToVisibilityConverter x:Key="Visible" />
        <v:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
        <v:StatusBrushConverter x:Key="StatusBrush" />

        <!-- One device row -->
        <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceRowViewModel}">
            <Border Padding="4,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Left" Margin="4,0,0,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        </StackPanel>
                    </Border>
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding IsIncluded}" Visibility="{Binding CanToggle, Converter={StaticResource Visible}}"
                              ToolTip="Include this device in blackouts" AutomationProperties.Name="{Binding Name}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One provider card -->
        <DataTemplate x:Key="ProviderCard" DataType="{x:Type vm:ProviderGroupViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                        Background="{Binding State, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                               Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                                </Border>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource SecondaryText}" Foreground="{StaticResource DangerBrush}"
                                       Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="12,2,0,0"
                                  IsChecked="{Binding IsEnabled}" ToolTip="Use this integration during blackouts"
                                  AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRow}" Margin="0,10,0,-6"
                                  Visibility="{Binding HasDevices, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / status -->
        <Border Grid.Row="0" Margin="24,20,24,0" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="12" VerticalAlignment="Center">
                    <Image Source="/Assets/Logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource TitleText}" />
                        <Ellipse Width="8" Height="8" Margin="10,3,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlackedOut}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasHotkeyError}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding HotkeyParts}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource KeyChip}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCommand}"
                        Padding="22,10" FontSize="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ToggleText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Nav -->
        <Grid Grid.Row="1" Margin="28,14,24,6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource NavButton}" Content="Devices" IsChecked="{Binding ShowDevices}" GroupName="Nav" />
                <RadioButton Style="{StaticResource NavButton}" Content="Settings" IsChecked="{Binding ShowSettings}" GroupName="Nav" />
            </StackPanel>
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding RefreshCommand}"
                    Visibility="{Binding ShowDevices, Converter={StaticResource Visible}}" ToolTip="Detect devices again">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Devices -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,6,24,12"
                      Visibility="{Binding ShowDevices, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Text="DISPLAYS" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding MonitorGroups}" ItemTemplate="{StaticResource ProviderCard}" />
                <TextBlock Text="LIGHTING" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="2,8,0,8" />
                <ItemsControl ItemsSource="{Binding LightingGroups}" ItemTemplate="{StaticResource ProviderCard}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,6,24,12"
                      Visibility="{Binding ShowSettings, Converter={StaticResource Visible}}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Blackout hotkey" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,12"
                                   Text="Works from anywhere, even in full-screen games. Press it again to restore. Click the box and press a new combination." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyInput" Width="260" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Cursor="Hand" FontWeight="SemiBold" Text="{Binding HotkeyText, Mode=OneWay}"
                                     AutomationProperties.Name="Blackout hotkey"
                                     PreviewKeyDown="HotkeyInput_PreviewKeyDown" GotKeyboardFocus="HotkeyInput_GotFocus"
                                     LostKeyboardFocus="HotkeyInput_LostFocus" />
                            <Button Content="Reset to Ctrl+Alt+B" Margin="10,0,0,0" Command="{Binding ResetHotkeyCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HotkeyError}" Style="{StaticResource SecondaryText}" Foreground="{StaticResource WarningBrush}"
                                   Margin="0,8,0,0" Visibility="{Binding HasHotkeyError, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Content="Start with Windows (in the tray)" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" Margin="0,12,0,0"
                                  Content="Show tray notifications" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Hardware power-off (DDC/CI)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,8"
                                   Text="The black overlay always covers every display. On top of that, monitors that support DDC/CI can switch their backlight off completely, which gives true zero light on LCD panels. Some monitors disconnect when powered down and make Windows rearrange your windows, so use Test before enabling it." />
                        <ItemsControl ItemsSource="{Binding DdcMonitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MonitorDdcViewModel}">
                                    <Border Padding="4,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding SupportText}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding TestResult}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Test" Command="{Binding TestCommand}" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsSupported}"
                                                      ToolTip="Power this monitor off during blackouts" AutomationProperties.Name="{Binding Name}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                                   Text="EasyBlackout only controls lighting while a blackout is active and hands it back to iCUE, Synapse, G HUB, GG, NGENUITY, OpenRGB or Windows as soon as you restore. If the app closes unexpectedly, each vendor app takes its lighting back by itself." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open log folder" Command="{Binding OpenLogsCommand}" />
                            <Button Content="Open settings folder" Margin="10,0,0,0" Command="{Binding OpenSettingsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Margin="28,0,24,12"
                   Text="Closing this window keeps EasyBlackout running in the tray." />
    </Grid>
</Window>
